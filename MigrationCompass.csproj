<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MigrationCompass</RootNamespace>
    <AssemblyName>MigrationCompass</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.8.2" />
    <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rules\BlockingRules.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\**\*.cs" />
    <Compile Remove="MigrationCompass.Specs\**\*.cs" />
    <None Include="Fixtures\**\*" />
  </ItemGroup>
</Project>
